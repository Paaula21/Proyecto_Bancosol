    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    color: #374151;
}

hr {
    display: none;
}

.content-wrapper {
    display: flex;
    gap: 24px;
    align-items: flex-start;
}

.list-container,
.detail-panel {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 24px;
}

.list-container {
    flex: 2;
    overflow-x: auto;
}

.detail-panel {
    flex: 1;
    min-height: 400px;
    display: flex;
    flex-direction: column;
}

.list-header {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    margin-bottom: 24px;
}

.list-header h2 {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
}

.list-header p {
    grid-column: 1;
    grid-row: 2;
    margin: 4px 0 0 0;
    font-size: 0.875rem;
    color: #6b7280;
}

.list-actions {
    grid-column: 2;
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    gap: 12px;
