* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f7f9;
    color: #111827;
}

header.cabecera {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    padding: 16px 32px;
    width: 100%;
}

header.cabecera nav {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: center;
}

header.cabecera h1 {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
}

header.cabecera p {
    grid-column: 1;
    grid-row: 2;
    margin: 4px 0 0 0;
    font-size: 0.875rem;
    color: #6b7280;
}

.top-bar-actions {
    grid-column: 2;
    grid-row: 1 / 3;
}

.top-bar-actions input {
    padding: 8px 16px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.875rem;
    width: 280px;
    background-color: #f9fafb;
    outline: none;
}

.main-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
}

main {
    padding: 24px 32px;
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.filters {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 20px 24px;
    display: flex;
    gap: 20px;
    align-items: flex-end;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
}

.filter-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
}

.filter-group select,
.filter-group input {
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.875rem;
    outline: none;
    background-color: #ffffff;
    color: #374151;
}

.filter-button {
    flex: 1;
}

.filter-button button {
    width: 100%;
    padding: 10px 12px;
