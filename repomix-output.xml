/* ======================================================== */
/* MODIFICADO: CONTENEDOR Y SCROLL IDÉNTICO A LA FOTO      */
/* ======================================================== */
.table-wrapper {
    max-height: 420px;
    overflow-y: auto;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    margin-top: 30px;
}

/* Ancho general de la barra de scroll */
.table-wrapper::-webkit-scrollbar {
    width: 14px; /* Un poco más ancha para que se noten las flechas como en la foto */
}

/* Fondo del carril del scroll (gris muy suave y limpio) */
.table-wrapper::-webkit-scrollbar-track {
    background: #fcfcfc;
    border-left: 1px solid #f1f1f1;
}

/* La pastilla / indicador (Gris oscuro y redondeada) */
.table-wrapper::-webkit-scrollbar-thumb {
    background: #aaaaaa;
    border-radius: 20px;
    border: 3px solid #fcfcfc; /* Crea un margen interior simulado alrededor de la pastilla */
}

/* Cambio de color sutil al pasar el ratón */
.table-wrapper::-webkit-scrollbar-thumb:hover {
    background: #888888;
}

/* Botones de flecha (Arriba y Abajo) para que quede exactamente igual */
.table-wrapper::-webkit-scrollbar-button:single-button {
    background-color: #fcfcfc;
    display: block;
    background-size: 10px;
    background-repeat: no-repeat;
    background-position: center;
    height: 14px;
}

/* Flecha hacia arriba */
.table-wrapper::-webkit-scrollbar-button:single-button:vertical:decrement {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' fill='%23555555'><polygon points='50,15 15,85 85,85'/></svg>");
}

/* Flecha hacia abajo */
.table-wrapper::-webkit-scrollbar-button:single-button:vertical:increment {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' fill='%23555555'><polygon points='15,15 85,15 50,85'/></svg>");
}

