.empty-state {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.empty-state p {
    margin: 0;
    font-size: 0.875rem;
    color: #6b7280;
    text-align: center;
}

.scrollbar-ui {
    display: none;
