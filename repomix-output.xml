    box-sizing: border-box;
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #f5f7f9;

    min-height: 100vh;
    overflow: visible;
}

/* Contenedor INTERIOR (El cuadro blanco) */
.historial-container {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);

    display: flex;
    flex-direction: column;

    /* Le decimos que ocupe el 80% del main y se centre a los lados */
    width: 80%;
    margin: 0 auto;
}

/* Cabecera */
.historial-header {
    border-bottom: 1px solid #eaeaea;
    padding-bottom: 1rem;
    margin-bottom: 1.2rem;

    flex-shrink: 0;
}

.historial-titulo {
    color: #0c1b33;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
}

/* Mensajes */
.historial-mensaje {
    text-align: center;
    color: #6b7280;
    padding: 1.5rem;
}

/* LISTA CON SCROLL */
.historial-lista {
    list-style: none;
    padding: 0 0.5rem 0 0;

    display: flex;
    flex-direction: column;
    gap: 0.7rem;

    /* scroll interno */
    overflow-y: auto;

    min-height: 0;

    margin-bottom: 24px;
}

/* Scroll */
.historial-lista::-webkit-scrollbar {
    width: 6px;
}


.historial-lista::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
}

/* Tarjetas */
.historial-item {
    border: 1px solid #e5e7eb;
    border-radius: 8px;

    padding: 1.25rem 1.2rem;

    display: flex;
    justify-content: space-between;
    align-items: center;

    background-color: #ffffff;

    flex-shrink: 0;
}

/* Columna izquierda */
.historial-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

/* Acción */
.historial-accion {
    font-weight: 700;
    color: #111827;
    font-size: 0.98rem;
}

/* Etiqueta */
.historial-etiqueta {
    color: #6b7280;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

/* Fecha */
.historial-fecha {
    color: #6b7280;
    font-size: 0.88rem;
}

/* Responsive */
@media (max-width: 650px) {
    .historial-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.8rem;
    }

    .historial-fecha {
        align-self: flex-start;
    }
}
