/* ======================================================== */
/* ESTILOS DEL POPUP / MODAL DE CONFIRMACIÓN DE ELIMINACIÓN  */
/* ======================================================== */

.overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.55);
    display: none;
    z-index: 9998;
}

.popup-confirmacion {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 28px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    display: none;
    z-index: 9999;
    width: 90%;
    max-width: 460px;
    text-align: center;
}

.overlay.active,
.popup-confirmacion.active {
    display: block;
}

.popup-confirmacion h3 {
    margin: 0 0 12px 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: #111827;
}

.popup-confirmacion p {
    margin: 0 0 24px 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #6b7280;
}

.popup-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
}

.btn-cancelar {
    padding: 10px 16px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid #d1d5db;
    background-color: #ffffff;
    color: #374151;
    transition: background-color 0.2s ease;
}

.btn-cancelar:hover {
    background-color: #f9fafb;
}

.btn-confirmar {
    padding: 10px 16px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    background-color: #ef4444;
    color: #ffffff;
    transition: background-color 0.2s ease;
}

.btn-confirmar:hover {
    background-color: #dc2626;
}

.btn-confirmar:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    cursor: not-allowed;
}
