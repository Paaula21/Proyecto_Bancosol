    gap: 24px;
}

.filters {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 20px 24px;
    display: flex;
    gap: 20px;
    align-items: flex-end;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
}

.filter-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
}

.filter-group select,
.filter-group input {
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.875rem;
    outline: none;
    background-color: #ffffff;
    color: #374151;
}

.filter-button {
    flex: 1;
}

.filter-button button {
    width: 100%;
    padding: 10px 12px;
    background-color: #f9fafb;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    color: #374151;
}

hr {
    display: none;
}

.content-wrapper {
    display: flex;
    gap: 24px;
    align-items: flex-start;
}

.list-container,
.detail-panel {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 24px;
}

.list-container {
    flex: 2;
    overflow-x: auto;
}

.detail-panel {
    flex: 1;
    min-height: 400px;
    display: flex;
    flex-direction: column;
}

.list-header {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    margin-bottom: 24px;
}

.list-header h2 {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
}

.list-header p {
    grid-column: 1;
    grid-row: 2;
    margin: 4px 0 0 0;
    font-size: 0.875rem;
    color: #6b7280;
}

.list-actions {
    grid-column: 2;
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    gap: 12px;
}

.list-actions button {
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    border: 1px solid #d1d5db;
    background-color: #ffffff;
    color: #374151;
}

.list-actions button:last-child {
    background-color: #420098;
    color: #ffffff;
    border-color: #420098;
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

th {
    padding: 12px 16px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
    border-bottom: 1px solid #e5e7eb;
}

td {
    padding: 16px;
    font-size: 0.875rem;
    color: #374151;
    border-bottom: 1px solid #f3f4f6;
    vertical-align: middle;
}

td strong {
    color: #111827;
    font-weight: 600;
}

td small {
    display: block;
    margin-top: 4px;
    color: #6b7280;
}

.detail-panel h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
}

.detail-panel > p {
    margin: 8px 0 0 0;
    font-size: 0.875rem;
    color: #6b7280;
}

.empty-state {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.empty-state p {
    margin: 0;
    font-size: 0.875rem;
    color: #6b7280;
    text-align: center;
}

.scrollbar-ui {
    display: none;
}
</file>

<file path="src/main/resources/templates/html/RegistroVoluntarios.html">
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="RegistroVoluntarios.css">
    <link rel="stylesheet" href="Sidebar.css">

    <title>Registro de Voluntarios</title>

    <script src="RegistroVoluntarios.js" defer></script>
</head>

<body>

<header class="cabecera">
    <nav>
        <h1>Voluntariado</h1>
        <p>Gestión de registro para los voluntarios</p>

        <div class="top-bar-actions">
            <input type="search" placeholder="Buscar...">
        </div>
    </nav>
</header>

<div class="main-layout">
    <!--Barra lateral que hay que añadir-->
    <aside class="sidebar">
    </aside>

    <main>
        <form id="form-register">
            <div class="content-wrapper">
                <section class="list-container">
                    <header class="user-header">
                        <h3>Información Personal</h3>
                        <p>
                            Nombre* <br>
                            <textarea name="nombre" cols="30" rows="1" type=text required> </textarea>
                        </p>

                        <p>
                            Email* <br>
                            <textarea name="email" cols="30" rows="1" type=email required> </textarea>
                        </p>
                        <p>
                            Teléfono (Opcional) <br>
                            <textarea name="telefono" cols="30" rows="1" type=tel min=9> </textarea>
                        </p>
                        <p>
                            Indique aquí las <b>observaciones</b> que debemos tener en cuenta sobre su disponibilidad:
                            <br> <br>
                            <textarea name="observacionesinfopersonal" cols="50" rows="1"> </textarea>
                        </p>
                    </header>
                </section>
            </div>

            <div class="content-wrapper">
                <section class="list-container">
                    <header class="list-header">
                        <h2>Disponibilidad de horarios</h2>
                        <p>Incluya aquí los horarios disponibles del voluntario</p>

                    </header>

                    <p>
                        <label>Especifique su <b>disponibilidad</b> de los siguientes turnos:</label> <br> <br>
                    <table>
                        <thead>
                        <tr>
                            <th>
                                Mañana/Tarde
                            </th>
                            <th>
                                Lunes
                            </th>
                            <th>
                                Martes
                            </th>
                            <th>
                                Miércoles
                            </th>
                            <th>
                                Jueves
                            </th>
                            <th>
                                Viernes
                            </th>
                            <th>
                                Sábado
                            </th>
                            <th>
                                Domingo
                            </th>
                        </tr>
                        </thead>

                        <tbody>
                        <tr>
                            <td> Mañana</td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                        </tr>
                        <tr>
                            <td> Tarde</td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                            <td><input type="checkbox" name="asistencia" value="si"></td>
                        </tr>
                        </tbody>
                    </table>
                    </p>

                    <br>

                    <p>
                        Indique aquí las <b>observaciones</b> que debemos tener en cuenta sobre su disponibilidad: <br>
                        <br>
                        <textarea name="observacionesdisponibilidad" cols="50" rows="1"> </textarea>
                    </p>

                    <div class="scrollbar-ui"></div>
                </section>
            </div>

            <div class="content-wrapper">
                <section class="list-container">
                    <h3>Finalización de la encuesta</h3>
                    <input type="submit" value="Enviar">
                </section>
            </div>
        </form>
    </main>

</div>
</body>
</html>
</file>

